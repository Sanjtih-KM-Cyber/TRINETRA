  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:integration": "node scripts/phase4-integration-test.mjs",
    "test:output": "tsx scripts/phase4-output-test.ts",
    "test:eval": "node scripts/eval-sahayak.mjs"
  },
  "dependencies": {
