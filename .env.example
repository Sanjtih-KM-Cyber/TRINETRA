# LLM Provider Configuration
# Select the active AI provider: ollama | groq | gemini
LLM_PROVIDER="ollama"

# Ollama / Local LLM Configuration (OpenAI-compatible endpoint)
# Default base URL for Ollama's OpenAI-compatible API
LOCAL_LLM_BASE_URL="http://localhost:11434/v1"
# Model to use (e.g., llama3.2, qwen2.5-coder, mistral, codellama)
LOCAL_LLM_MODEL="llama3.2"

# Groq Configuration
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key_here"
# Groq model (e.g., llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768)
GROQ_MODEL="llama-3.3-70b-versatile"

# Google Gemini Configuration
# Get your API key from https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_api_key_here"
# Gemini model (e.g., gemini-2.5-flash, gemini-1.5-pro)
GEMINI_MODEL="gemini-2.5-flash"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# Optional: Request timeout in milliseconds (default: 10000)
LLM_REQUEST_TIMEOUT_MS="10000"