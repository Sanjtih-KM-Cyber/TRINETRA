# LLM Provider Configuration
# Select the active AI provider: ollama | groq | gemini
LLM_PROVIDER="ollama"

# Ollama / Local LLM Configuration (OpenAI-compatible endpoint)
# Default base URL for Ollama's OpenAI-compatible API
LOCAL_LLM_BASE_URL="http://localhost:11434/v1"
# Model to use (e.g., llama3.2, qwen2.5-coder, mistral, codellama)
LOCAL_LLM_MODEL="llama3.2"

# Groq Configuration
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key_here"
# Multi-key rotation: comma-separated keys are cycled round-robin; a 429
# parks that key for 60s and a 401/403 retires it, then the next key serves.
# When all Groq keys are exhausted the pipeline fails over to Gemini keys.
GROQ_API_KEYS=""
# Groq model (verified live; llama-3.3-70b-versatile is decommissioned)
GROQ_MODEL="openai/gpt-oss-120b"

# Google Gemini Configuration
# Get your API key from https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_api_key_here"
# Multi-key rotation (same semantics as GROQ_API_KEYS). Gemini keys serve as
# automatic failover when every Groq key is exhausted, and vice versa.
GEMINI_API_KEYS=""
# Gemini model (e.g., gemini-2.5-flash, gemini-1.5-pro)
GEMINI_MODEL="gemini-2.5-flash"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# Optional: Request timeout in milliseconds (default: 10000)
LLM_REQUEST_TIMEOUT_MS="10000"

# --- Phase 0: VPN Gateway + Demo Mode ---
# CCTNS_DEMO_MODE=true  -> demo gateway mount (seeded badge+PIN accepted, mTLS optional)
# CCTNS_DEMO_MODE=false -> production (badge+PIN+6-digit OTP+mTLS client cert required)
CCTNS_DEMO_MODE="true"
VPN_GATEWAY_ID="CCTNS-GW-MH-01"
PORT="3000"

# JWT signing key for officer sessions (change in production)
JWT_SECRET="trinetra-os-national-security-vault-key-2026"

# --- Vault encryption at rest (AES-256-GCM) ---
# 32-byte key as 64 hex chars (or base64 / passphrase — stretched via scrypt).
# Every upload, AI brief, diary proceeding and charge-sheet narrative is
# encrypted before hitting Mongo/snapshot and decrypted transparently on read.
# Unset -> persistent derived dev key (stable across restarts, NOT for prod).
# VAULT_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# --- Vault persistence (Phase 6 hardening) ---
# Unset/empty -> high-performance in-memory vault (data resets on restart).
# Set to a MongoDB connection string for durable storage; the vault seeds
# itself on first connect and skips seeding when officers already exist.
# MONGO_URL="mongodb://127.0.0.1:27017"
MONGO_DB="crimintel"

# Frontend (Vite) mirrors — set these in a .env file for local dev:
# VITE_CCTNS_DEMO_MODE="true"
# VITE_VPN_GATEWAY="CCTNS-GW-MH-01"
# VITE_VPN_PINNED_FINGERPRINT="A1:B2:C3:D4:E5:F6:78:90:AB:CD:EF:12:34:56:78:90"

# --- Split deploy: Vercel (frontend) + Render (backend) ---
# Vercel → set as Environment Variables on the frontend project:
# VITE_API_URL="https://<your-render-service>.onrender.com"
# (optional override) VITE_WS_URL="wss://<your-render-service>.onrender.com/ws/case-updates"
# Render → set as Environment Variables on the web service:
# FRONTEND_URL="https://<your-vercel-app>.vercel.app"
# SKIP_STATIC="true"  (backend serves API+WS only; Vercel serves the UI)

# --- Phase 5: Federated model mesh (LoRA adapters via llama.cpp) ---
# Local LoRA endpoint probed by /api/sahayak/health (llama.cpp server with --lora adapters)
LORA_ENDPOINT="http://localhost:8080"
# Mesh peers (JSON array). Each peer runs an OpenAI-compatible /chat/completions
# endpoint (llama.cpp server or Ollama) and advertises LoRA adapter tags.
# Join peers over Tailscale: use 100.x or *.ts.net baseUrls.
MESH_PEERS='[]'
# MESH_PEERS='[{"name":"hq-legal","baseUrl":"http://100.64.0.5:8080","adapters":["legal-lora"],"models":["legal-lora"]}]'
# Tailscale hostname of this node (surfaced in mesh status when set)
TAILSCALE_HOSTNAME=""